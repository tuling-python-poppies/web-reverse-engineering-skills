{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-protocol-recovery-provider-work-order-v2.schema.json",
  "title": "web-protocol-recovery provider work order v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "workOrderId", "shape", "gateFamily", "activeProvider", "project", "authorization", "readPlan", "acceptanceTest", "runtimeCustody", "runtimeIds"],
  "properties": {
    "schemaVersion": {"const": "web-protocol-recovery-provider-work-order/v2"},
    "workOrderId": {"type": "string", "minLength": 1},
    "shape": {"enum": ["evidence", "local-proof", "compact-replay", "collector"]},
    "gateFamily": {"enum": ["signer", "challenge", "verifier", "decode", "session", "transport"]},
    "secondaryGates": {
      "type": "array",
      "items": {"enum": ["signer", "challenge", "verifier", "decode", "session", "transport"]},
      "uniqueItems": true
    },
    "canonicalMutationPoint": {"type": ["string", "null"]},
    "activeProvider": {"$ref": "#/$defs/providerRef"},
    "protocolOwner": {"type": ["string", "null"]},
    "implementation": {
      "type": ["object", "null"],
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["iv8", "python-node", "pure-python"]},
        "strategy": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]}
      }
    },
    "deliveryProvider": {"type": ["string", "null"]},
    "caseId": {"type": ["string", "null"]},
    "authorization": {
      "type": "object",
      "required": ["liveReplayAllowed", "actionClass", "allowedHostsAndRoutes", "requestBudget", "artifactPolicy", "executionPolicy"],
      "properties": {
        "authorizationBasis": {"type": "string"},
        "liveReplayAllowed": {"type": "boolean"},
        "actionClass": {"enum": ["none", "read-only", "verifier-submit", "mutation-submit"]},
        "accountOrSessionUse": {"type": "string"},
        "browserReconAllowed": {"type": "boolean"},
        "browserNavigationSideEffectsApproved": {"type": "boolean"},
        "allowedHostsAndRoutes": {"type": "array", "items": {"$ref": "#/$defs/routeScope"}},
        "requestBudget": {"$ref": "#/$defs/requestBudget"},
        "artifactPolicy": {"$ref": "#/$defs/artifactPolicy"},
        "executionPolicy": {"$ref": "#/$defs/executionPolicy"}
      }
    },
    "project": {
      "type": "object",
      "required": ["projectRoot", "layout", "writeMode", "allowedPaths"],
      "properties": {
        "projectRoot": {"type": "string", "minLength": 1},
        "layout": {"const": "web-protocol-recovery-simple"},
        "writeMode": {"enum": ["no-write", "create-only", "modify-allowlisted"]},
        "allowedPaths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readPlan": {
      "type": "object",
      "required": ["window", "required", "optional"],
      "properties": {
        "window": {"type": "string", "minLength": 1},
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {"type": "array"},
    "requiredOutputs": {"type": "array"},
    "acceptanceTest": {"type": "string", "minLength": 1},
    "runtimeCustody": {
      "type": "object",
      "required": ["providerOwnsBrowser", "providerOwnsWorker", "providerOwnsLease"],
      "properties": {
        "providerOwnsBrowser": {"type": "boolean"},
        "providerOwnsWorker": {"type": "boolean"},
        "providerOwnsLease": {"type": "boolean"}
      }
    },
    "runtimeIds": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "providerRef": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["reconnaissance", "protocol-recovery", "implementation", "delivery"]},
        "strategy": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]}
      }
    },
    "routeScope": {
      "type": "object",
      "required": ["scheme", "host", "port", "routePrefix", "queryPolicy"],
      "properties": {
        "scopeId": {"type": "string"},
        "scheme": {"enum": ["http", "https"]},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "routePrefix": {"type": "string", "pattern": "^/"},
        "queryPolicy": {"$ref": "#/$defs/queryPolicy"}
      }
    },
    "queryPolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["deny", "allow-listed", "allow-all"]},
        "allowedKeys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowedValues": {"type": "object"}
      }
    },
    "requestBudget": {
      "type": "object",
      "required": ["total", "remaining"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "remaining": {"type": "integer", "minimum": 0},
        "minDelayMs": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "automaticObservationStopThreshold": {"type": "integer", "minimum": 0},
        "observedAutomatic": {"type": "object"},
        "maxRequests": {"type": "integer", "minimum": 0},
        "redirects": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "responseByteCap": {"type": "integer", "minimum": 0}
      }
    },
    "artifactPolicy": {
      "type": "object",
      "required": ["mode", "repositoryExcluded", "approvedRawFields", "retentionDeadline"],
      "properties": {
        "mode": {"enum": ["metadata-only", "allowlisted-raw"]},
        "repositoryExcluded": {"type": "boolean"},
        "approvedRawFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "retentionDeadline": {"type": "string", "minLength": 1}
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": ["targetCodeExecution"],
      "properties": {
        "targetCodeExecution": {"enum": ["blocked", "local-only", "approved-reviewed-hash"]},
        "approvedCodeSha256": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "uniqueItems": true
        },
        "dependencyInstall": {"type": "string"},
        "approvedCommands": {"type": "array", "items": {"type": "string"}},
        "approvalEvidence": {"type": "string"},
        "approvalDeadline": {"type": "string"}
      }
    }
  }
}
