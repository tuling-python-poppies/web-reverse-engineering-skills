{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "web-protocol-recovery-provider-work-order.schema.json",
  "title": "web-protocol-recovery provider work order v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "workOrderId", "shape", "gateFamily", "activeProvider", "project", "authorization", "readPlan", "acceptanceTest", "runtimeCustody", "runtimeIds"],
  "properties": {
    "schemaVersion": {"const": "web-protocol-recovery-provider-work-order"},
    "workOrderId": {"type": "string", "minLength": 1},
    "shape": {"enum": ["evidence", "local-proof", "compact-replay", "collector"]},
    "gateFamily": {"enum": ["signer", "challenge", "verifier", "decode", "session", "transport"]},
    "secondaryGates": {
      "type": "array",
      "items": {"enum": ["signer", "challenge", "verifier", "decode", "session", "transport"]},
      "uniqueItems": true
    },
    "canonicalMutationPoint": {"type": ["string", "null"]},
    "activeProvider": {"$ref": "#/$defs/providerRef"},
    "protocolOwner": {"type": ["string", "null"]},
    "implementation": {
      "type": ["object", "null"],
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["iv8", "python-node", "pure-python"]},
        "strategy": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]}
      }
    },
    "deliveryProvider": {"type": ["string", "null"]},
    "caseId": {"type": ["string", "null"]},
    "authorization": {
      "type": "object",
      "required": ["liveReplayAllowed", "actionClass", "actionApproval", "allowedHostsAndRoutes", "requestBudget", "artifactPolicy", "executionPolicy"],
      "properties": {
        "authorizationBasis": {"type": "string"},
        "liveReplayAllowed": {"type": "boolean"},
        "actionClass": {"enum": ["none", "read-only", "verifier-submit", "mutation-submit"]},
        "actionApproval": {"enum": ["standing-read-only", "standing-verifier-submit", "user-confirmed-mutation"]},
        "accountOrSessionUse": {"type": "string"},
        "browserReconAllowed": {"type": "boolean"},
        "browserNavigationSideEffectsApproved": {"type": "boolean"},
        "allowedHostsAndRoutes": {"type": "array", "items": {"$ref": "#/$defs/routeScope"}},
        "requestBudget": {"$ref": "#/$defs/requestBudget"},
        "artifactPolicy": {"$ref": "#/$defs/artifactPolicy"},
        "executionPolicy": {"$ref": "#/$defs/executionPolicy"}
      },
      "allOf": [
        {
          "if": {"properties": {"actionClass": {"const": "mutation-submit"}}, "required": ["actionClass"]},
          "then": {
            "required": ["actionApproval"],
            "properties": {"actionApproval": {"const": "user-confirmed-mutation"}}
          }
        },
        {
          "if": {"properties": {"actionApproval": {"const": "user-confirmed-mutation"}}, "required": ["actionApproval"]},
          "then": {"properties": {"actionClass": {"enum": ["mutation-submit", "verifier-submit"]}}}
        },
        {
          "if": {"properties": {"actionClass": {"const": "verifier-submit"}}, "required": ["actionClass"]},
          "then": {"properties": {"actionApproval": {"enum": ["standing-verifier-submit", "user-confirmed-mutation"]}}}
        },
        {
          "if": {"properties": {"actionApproval": {"const": "standing-verifier-submit"}}, "required": ["actionApproval"]},
          "then": {"properties": {"actionClass": {"const": "verifier-submit"}}}
        },
        {
          "if": {"properties": {"actionApproval": {"const": "standing-read-only"}}, "required": ["actionApproval"]},
          "then": {"properties": {"actionClass": {"enum": ["none", "read-only"]}}}
        },
        {
          "if": {"properties": {"actionClass": {"enum": ["none", "read-only"]}}, "required": ["actionClass"]},
          "then": {
            "required": ["actionApproval"],
            "properties": {"actionApproval": {"const": "standing-read-only"}}
          }
        },
        {
          "if": {"properties": {"liveReplayAllowed": {"const": true}}, "required": ["liveReplayAllowed"]},
          "then": {
            "properties": {
              "allowedHostsAndRoutes": {"minItems": 1},
              "requestBudget": {
                "properties": {
                  "total": {"minimum": 1},
                  "remaining": {"minimum": 1}
                }
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "required": ["projectRoot", "layout", "writeMode", "allowedPaths"],
      "properties": {
        "projectRoot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|/)"
        },
        "layout": {"const": "web-protocol-recovery-simple"},
        "writeMode": {"enum": ["no-write", "create-only", "modify-allowlisted"]},
        "allowedPaths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "readPlan": {
      "type": "object",
      "required": ["window", "required", "optional"],
      "properties": {
        "window": {"type": "string", "minLength": 1},
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inputs": {"type": "array"},
    "requiredOutputs": {"type": "array"},
    "acceptanceTest": {"type": "string", "minLength": 1},
    "runtimeCustody": {
      "type": "object",
      "required": ["providerOwnsBrowser", "providerOwnsWorker", "providerOwnsLease"],
      "properties": {
        "providerOwnsBrowser": {"type": "boolean"},
        "providerOwnsWorker": {"type": "boolean"},
        "providerOwnsLease": {"type": "boolean"}
      }
    },
    "runtimeIds": {"type": "array", "items": {"$ref": "#/$defs/runtimeId"}}
  },
  "$defs": {
    "providerRef": {
      "type": "object",
      "required": ["id", "role", "strategy", "profile"],
      "properties": {
        "id": {
          "enum": [
            "chromium-recon",
            "camoufox",
            "wechat-miniapp",
            "browser-hooks",
            "ast",
            "verifier",
            "akamai",
            "river-security",
            "reese84",
            "iv8",
            "python-node",
            "pure-python",
            "python-collector"
          ]
        },
        "role": {"enum": ["reconnaissance", "protocol-recovery", "implementation", "delivery"]},
        "strategy": {"type": ["string", "null"]},
        "profile": {"type": ["string", "null"]}
      }
    },
    "routeScope": {
      "type": "object",
      "required": ["scheme", "host", "port", "routePrefix", "queryPolicy"],
      "properties": {
        "scopeId": {"type": "string"},
        "scheme": {"enum": ["http", "https"]},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "routePrefix": {"type": "string", "pattern": "^/"},
        "queryPolicy": {"$ref": "#/$defs/queryPolicy"}
      }
    },
    "queryPolicy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["deny", "allow-listed", "allow-all"]},
        "allowedKeys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "allowedValues": {"type": "object"}
      }
    },
    "requestBudget": {
      "type": "object",
      "required": [
        "total",
        "remaining",
        "minDelayMs",
        "concurrency",
        "automaticObservationStopThreshold",
        "observedAutomatic"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "remaining": {"type": "integer", "minimum": 0},
        "minDelayMs": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 1},
        "automaticObservationStopThreshold": {"type": "integer", "minimum": 0},
        "observedAutomatic": {
          "type": "object",
          "required": ["total", "byKind", "destinations"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "byKind": {
              "type": "object",
              "required": ["redirect", "subresource", "xhrFetch", "beaconPing", "eventSource", "websocket"],
              "properties": {
                "redirect": {"type": "integer", "minimum": 0},
                "subresource": {"type": "integer", "minimum": 0},
                "xhrFetch": {"type": "integer", "minimum": 0},
                "beaconPing": {"type": "integer", "minimum": 0},
                "eventSource": {"type": "integer", "minimum": 0},
                "websocket": {"type": "integer", "minimum": 0}
              }
            },
            "destinations": {"type": "array", "items": {"type": "object"}}
          }
        },
        "budgetLedgerId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ledgerPath": {"type": "string", "minLength": 1},
        "maxRequests": {"type": "integer", "minimum": 0},
        "redirects": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "responseByteCap": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"required": ["budgetLedgerId"]},
          "then": {"required": ["ledgerPath"]}
        },
        {
          "if": {"required": ["ledgerPath"]},
          "then": {"required": ["budgetLedgerId"]}
        }
      ]
    },
    "artifactPolicy": {
      "type": "object",
      "required": ["mode", "repositoryExcluded", "approvedRawFields", "retentionDeadline", "rawSecretHandling"],
      "properties": {
        "mode": {"enum": ["metadata-only", "allowlisted-raw"]},
        "repositoryExcluded": {"type": "boolean"},
        "approvedRawFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "retentionDeadline": {"type": "string", "minLength": 1},
        "rawSecretHandling": {"enum": ["blocked", "confirmed"]}
      }
    },
    "executionPolicy": {
      "type": "object",
      "required": [
        "targetCodeExecution",
        "approvedCodeSha256",
        "dependencyInstall",
        "approvedCommands",
        "approvalEvidence",
        "approvalDeadline"
      ],
      "properties": {
        "targetCodeExecution": {"enum": ["blocked", "local-only", "approved-reviewed-hash"]},
        "approvedCodeSha256": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "uniqueItems": true
        },
        "dependencyInstall": {"enum": ["blocked", "approved"]},
        "approvedCommands": {"type": "array", "items": {"type": "string"}},
        "approvalEvidence": {"type": "string"},
        "approvalDeadline": {"type": ["string", "null"], "format": "date-time"},
        "sandbox": {
          "type": "object",
          "required": ["backend", "adapterId", "adapterSha256", "capabilityEvidence", "timeoutMs", "outputByteCap"],
          "properties": {
            "backend": {"enum": ["capability-denied-external"]},
            "adapterId": {"type": "string", "minLength": 1},
            "adapterSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "capabilityEvidence": {"type": "string", "minLength": 1},
            "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 60000},
            "outputByteCap": {"type": "integer", "minimum": 1024, "maximum": 10485760}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"targetCodeExecution": {"const": "approved-reviewed-hash"}},
            "required": ["targetCodeExecution"]
          },
          "then": {
            "required": ["sandbox"],
            "properties": {
              "approvedCodeSha256": {"minItems": 1},
              "approvalEvidence": {"type": "string", "minLength": 1},
              "approvalDeadline": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          }
        }
      ]
    },
    "runtimeId": {
      "type": "object",
      "required": ["resourceId", "engine", "contextId", "targetId", "navigationEpoch", "owner", "lifecycle"],
      "properties": {
        "resourceId": {"type": "string", "minLength": 1},
        "engine": {"type": "string", "minLength": 1},
        "contextId": {"type": ["string", "integer", "null"]},
        "targetId": {"type": ["string", "integer", "null"]},
        "navigationEpoch": {"type": "integer", "minimum": 0},
        "owner": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["live", "stale", "retained", "released"]},
        "retention": {
          "type": "object",
          "required": ["reason", "approvalEvidence", "releaseDeadline"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "approvalEvidence": {"type": "string", "minLength": 1},
            "releaseDeadline": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle": {"const": "retained"}}, "required": ["lifecycle"]},
          "then": {"required": ["retention"]}
        }
      ]
    }
  }
}
